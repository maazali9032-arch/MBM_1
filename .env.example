# =============================================================================
# MAHEK — Environment variables (project root .env)
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# =============================================================================

# --- SUPABASE (required) ---
# Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# ⚠️  DO NOT put SUPABASE SERVICE ROLE KEY in this file or anywhere in the React app.
#     The service role bypasses RLS and must only be used server-side (scripts, workers
#     you fully control). This project uses the ANON key + RLS + admin_users allowlist.

# --- CLOUDFLARE R2 + UPLOAD WORKER (required for admin image uploads) ---
# Deploy workers/upload first, then paste the worker URL here (no trailing slash).
# Leave blank until the worker is deployed — admin uploads will fail until set.
VITE_UPLOAD_WORKER_URL=https://mahek-upload-worker.YOUR_SUBDOMAIN.workers.dev

# Public URL where R2 images are served (must match worker secret R2_PUBLIC_URL).
# Option A: R2.dev public bucket URL  →  https://pub-xxxxxxxx.r2.dev
# Option B: Custom domain on bucket   →  https://cdn.yourdomain.com
VITE_R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# =============================================================================
# CLOUDFLARE WORKER SECRETS (NOT in .env — set via wrangler in workers/upload/)
# Run from:  cd workers/upload
#
#   npx wrangler secret put SUPABASE_URL
#   npx wrangler secret put SUPABASE_ANON_KEY
#   npx wrangler secret put R2_PUBLIC_URL
#   npx wrangler secret put ALLOWED_ORIGINS
#
# ALLOWED_ORIGINS example:
#   http://localhost:5173,https://your-live-domain.com
#
# R2 bucket name is in workers/upload/wrangler.toml → bucket_name = "mahek"
# =============================================================================
